import java.util.Scanner;
public class ArenaDosHerois {
public static void main(String[] args) {

    Scanner leia = new Scanner(System.in);

    String[] herois = {"Guerreiro", "Arqueiro", "Mago"};
    int[] vidaInicial = {100, 80, 60};
    int[] ataque = {20, 15, 25};

    int[][] vida = {
        {100, 80, 60},
        {100, 80, 60}
    };

    int opcao, jogador = 0;
    int[] vitorias = {0, 0};
    boolean fim = false;

    do {

        System.out.println("\n1 - Iniciar batalha");
        System.out.println("2 - Consultar herois");
        System.out.println("3 - Consultar status");
        System.out.println("4 - Reiniciar jogo");
        System.out.println("0 - Sair");
        System.out.print("Opcao: ");

        opcao = leia.nextInt();

        switch (opcao) {

            case 1:

                fim = false;

                while (!fim) {

                    System.out.println("\nJogador " + (jogador + 1));

                    System.out.println("Escolha seu heroi:");

                    for (int i = 0; i < 3; i++) {
                        System.out.println((i + 1) + " - " + herois[i]
                                + " Vida: " + vida[jogador][i]);
                    }

                    System.out.print("Opcao: ");
                    int escolha = leia.nextInt() - 1;

                    if (escolha < 0 || escolha > 2 ||
                            vida[jogador][escolha] == 0) {
                        System.out.println("Heroi invalido!");
                        continue;
                    }

                    int adversario = 1 - jogador;

                    System.out.println("Escolha o adversario:");

                    for (int i = 0; i < 3; i++) {
                        System.out.println((i + 1) + " - " + herois[i]
                                + " Vida: " + vida[adversario][i]);
                    }

                    System.out.print("Opcao: ");
                    int alvo = leia.nextInt() - 1;

                    if (alvo < 0 || alvo > 2 ||
                            vida[adversario][alvo] == 0) {
                        System.out.println("Adversario invalido!");
                        continue;
                    }

                    vida[adversario][alvo] =
                            vida[adversario][alvo] - ataque[escolha];

                    if (vida[adversario][alvo] < 0) {
                        vida[adversario][alvo] = 0;
                    }

                    System.out.println("\n" + herois[escolha]
                            + " atacou " + herois[alvo]);

                    System.out.println("Dano: " + ataque[escolha]);
                    System.out.println("Vida restante: "
                            + vida[adversario][alvo]);

                    if (vida[adversario][alvo] == 0) {
                        System.out.println("Heroi eliminado!");
                    }

                    boolean perdeu = true;

                    for (int i = 0; i < 3; i++) {
                        if (vida[adversario][i] > 0) {
                            perdeu = false;
                        }
                    }

                    if (perdeu) {
                        System.out.println("\nJogador "
                                + (jogador + 1) + " venceu!");

                        vitorias[jogador]++;

                        System.out.println("Jogador 1: " + vitorias[0]);
                        System.out.println("Jogador 2: " + vitorias[1]);

                        fim = true;

                    } else {
                        jogador = adversario;
                    }
                }

                break;

            case 2:

                for (int i = 0; i < 3; i++) {
                    System.out.println(herois[i]);
                    System.out.println("Vida: " + vidaInicial[i]);
                    System.out.println("Ataque: " + ataque[i]);
                }

                break;

            case 3:

                for (int j = 0; j < 2; j++) {
                    System.out.println("Jogador " + (j + 1));

                    for (int i = 0; i < 3; i++) {
                        System.out.println(herois[i] + ": "
                                + vida[j][i] + " HP");
                    }
                }

                break;

            case 4:

                for (int j = 0; j < 2; j++) {
                    for (int i = 0; i < 3; i++) {
                        vida[j][i] = vidaInicial[i];
                    }
                }

                jogador = 0;
                fim = false;

                System.out.println("Jogo reiniciado!");

                break;

            case 0:

                System.out.println("Saindo...");

                break;

            default:

                System.out.println("Opcao invalida!");

        }

    } while (opcao != 0);

    leia.close();
}
}


