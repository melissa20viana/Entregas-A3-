7-  import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[6];
        int somaPares = 0;
        int qtdImpares = 0;

        System.out.println("Digite seis números inteiros:");

        for (int i = 0; i < 6; i++) {
            numeros[i] = entrada.nextInt();

            if (numeros[i] % 2 == 0) {
                somaPares += numeros[i];
            } else {
                qtdImpares++;
            }
        }

        System.out.println("Números pares:");
        for (int i = 0; i < 6; i++) {
            if (numeros[i] % 2 == 0) {
                System.out.print(numeros[i] + " ");
            }
        }

        System.out.println("\nSoma dos pares: " + somaPares);

        System.out.println("Números ímpares:");
        for (int i = 0; i < 6; i++) {
            if (numeros[i] % 2 != 0) {
                System.out.print(numeros[i] + " ");
            }
        }

        System.out.println("\nQuantidade de ímpares: "
                           + qtdImpares);

        entrada.close();
    }
}










