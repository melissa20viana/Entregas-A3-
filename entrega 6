3- import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[8];
        int[] positivos = new int[8];
        int[] negativos = new int[8];

        int qtdPositivos = 0;
        int qtdNegativos = 0;

        for (int i = 0; i < 8; i++) {
            System.out.print("Digite um número inteiro: ");
            numeros[i] = entrada.nextInt();

            if (numeros[i] > 0) {
                positivos[qtdPositivos] = numeros[i];
                qtdPositivos++;
            } else if (numeros[i] < 0) {
                negativos[qtdNegativos] = numeros[i];
                qtdNegativos++;
            }
        }

        System.out.println("Números positivos:");
        for (int i = 0; i < qtdPositivos; i++) {
            System.out.print(positivos[i] + " ");
        }

        System.out.println("\nNúmeros negativos:");
        for (int i = 0; i < qtdNegativos; i++) {
            System.out.print(negativos[i] + " ");
        }

        entrada.close();
    }
}



4-  import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[10];

        for (int i = 0; i < 10; i++) {
            System.out.print("Digite um número inteiro: ");
            numeros[i] = entrada.nextInt();
        }

        System.out.println("Números primos e suas posições:");

        for (int i = 0; i < 10; i++) {
            boolean primo = numeros[i] > 1;

            for (int j = 2; j * j <= numeros[i]; j++) {
                if (numeros[i] % j == 0) {
                    primo = false;
                    break;
                }
            }

            if (primo) {
                System.out.println(
                    "Número: " + numeros[i]
                    + " - Posição: " + (i + 1)
                );
            }
        }

        entrada.close();
    }
}
